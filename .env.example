# Copiar a .env y ajustar. El .env NO se commitea (esta en .gitignore).

# Conexion desde el HOST (Alembic, scripts, uvicorn local).
# Dentro de docker-compose el backend usa el host "db" en vez de "localhost".
DATABASE_URL=postgresql://mystoreexe:mystoreexe@localhost:5432/mystoreexe

# Clave para firmar los JWT. En produccion generar una nueva:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-in-production

# Datos del tenant y admin que crea scripts/seed.py
SEED_TENANT_DOMAIN=localhost
SEED_TENANT_NAME=Tienda Demo
SEED_ADMIN_EMAIL=admin@mystoreexe.com
SEED_ADMIN_PASSWORD=admin1234
