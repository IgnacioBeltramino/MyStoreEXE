# Copiar a .env y ajustar. El .env NO se commitea (esta en .gitignore).
# Este archivo SI se commitea: no pongas secretos reales aca.

# development | production. En production el backend se niega a arrancar si
# SECRET_KEY sigue siendo la de desarrollo.
APP_ENV=development

# --- Base de datos ---
# Estas tres las consume docker-compose para levantar Postgres.
# OJO: Postgres solo las aplica cuando crea el volumen por primera vez. Si ya
# levantaste la base y cambias la password, hay que correr:
#   docker compose exec db psql -U <user> -d <db> -c "ALTER USER <user> WITH PASSWORD '<nueva>';"
POSTGRES_USER=mystoreexe
POSTGRES_PASSWORD=CAMBIAR-generar-una-password-larga
POSTGRES_DB=mystoreexe

# Conexion desde el HOST (Alembic, scripts, uvicorn local).
# Dentro de docker-compose el backend usa el host "db" en vez de "localhost".
DATABASE_URL=postgresql://mystoreexe:CAMBIAR-generar-una-password-larga@localhost:5432/mystoreexe

# --- Seguridad ---
# Clave para firmar los JWT. NUNCA dejar la de desarrollo: con ella cualquiera
# se firma un token y entra como quien quiera. Generar la propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-in-production

# Dominios desde los que el navegador puede llamar a la API, separados por coma.
# En produccion van los dominios reales de las tiendas, nunca "*".
CORS_ORIGINS=http://localhost:5173

# --- Seed ---
# Datos del tenant y admin que crea scripts/seed.py.
# La password se usa una sola vez, al crear el usuario: ponete una propia y
# cambiala desde el panel despues del primer login.
SEED_TENANT_DOMAIN=localhost
SEED_TENANT_NAME=Tienda Demo
SEED_ADMIN_EMAIL=admin@mystoreexe.com
SEED_ADMIN_PASSWORD=CAMBIAR-antes-de-correr-el-seed
